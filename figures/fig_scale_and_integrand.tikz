\begin{tikzpicture}[>=Latex]
% left panel
\draw[->] (0,0) -- (4.5,0) node[right] {$t/t_0$};
\draw[->] (0,0) -- (0,3.0) node[above] {$a(t)$};
\draw[blue,thick,domain=0.2:4,smooth] plot (\x,{0.35+0.18*\x+0.10*\x*\x});
\node at (2.2,2.6) {$a(t)$ (convex growth)};

% right panel
\begin{scope}[xshift=6.2cm]
\draw[->] (0,0) -- (4.5,0) node[right] {$t/t_0$};
\draw[->] (0,0) -- (0,3.0) node[above] {$\propto 1/a(t)$};
\draw[green!60!black,thick,domain=0.2:4,smooth] plot (\x,{2.8/(0.6+0.45*\x)});
\node at (2.3,2.5) {$1/a(t)$};
\node at (2.2,0.7) {early epochs weighted strongly};
\end{scope}
\end{tikzpicture}
